set -e
touch "$HOME/.quickpilerc"
BUILD_DIR="$(sed -n '1p' "$HOME"/.quickpilerc)"
STATIC="$(sed -n '2p' "$HOME"/.quickpilerc)"
if [ "$(uname -o 2>/dev/null)" = "Android" ] || [ -d "/data/data/com.termux/files" ]; then
    CLANGPP=aarch64-linux-android-clang++
    echo "warning: static linking may fail on android"
else
    CLANGPP=clang++
fi
if [ "$1" = "--configure" ]; then
    while [ ! -d "$conf" ]; do
        printf 'which directory do you wish for me to live in: '
        read conf
    done
    echo "New default directory: $conf"
    while [ ! "$conf2" = "static" ] && [ ! "$conf2" = "dynamic" ]; do
        printf 'Do you wish do set static as standard compilation method[static/dynamic]: '
        read conf2
    done
    conf2=$(printf '%s' "$conf2" | tr '[:upper:]' '[:lower:]')
    echo -e "${conf}\n${conf2}" > "$HOME/.quickpilerc"
    exit 0
fi
if [ -z "$BUILD_DIR" ]; then
    echo "Error: .quickpilerc couldnt be found. make sure \$HOME is set and .quickpilerc is configured"
    exit 1
fi
if [ "$1" = "--static" ] || [ "$1" = "--dynamic" ]; then
    LINKMODE="$1"
    shift
else
    LINKMODE="--$STATIC"
fi
NAME="$1"
BUILD_NAME="${NAME%.*}"
if [ "$LINKMODE" = "--dynamic" ]; then
    "$CLANGPP" -O2 "$BUILD_DIR/$NAME" -o "$BUILD_DIR/${BUILD_NAME}_compiled"
elif [ "$LINKMODE" = "--static" ]; then
    "$CLANGPP" -O2 -static "$BUILD_DIR/$NAME" -o "$BUILD_DIR/${BUILD_NAME}_compiled"
else
    echo "Couldnt determine linking method. make sure \$HOME/.quickpilerc is properly configured."
fi
