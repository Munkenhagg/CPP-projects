set -euo pipefail

if [ -z "${1:-}" ]; then
    echo "Please provide a file"
    exit 1
fi

# Normalize name (strip any path the user passed)
INPUT="$1"
BASE="$(basename -- "$INPUT")"
NAMEALT="${BASE%.*}"

# Directory where this script lives
touch "$HOME/.quickpilerc"
DIR="$(head -n 1 $HOME/.quickpilerc)"
if [ "$1" = "--configure" ]; then
    printf 'which directory do you wish for me to live in: '
    read conf
    echo "$conf" > "$HOME/.quickpilerc"
    exit 0
fi
if [ -z "$DIR" ]; then
    echo "Error: .quickpilerc couldnt be found. make sure \$HOME is set and accessable"
    exit 1
fi
CAND1="$DIR/$BASE"
CAND2="$DIR/${NAMEALT}_compiled"

# Prefer an executable with the exact name, else the _compiled one
if [ -x "$CAND1" ]; then
    shift
    exec "$CAND1" "$@"
elif [ -x "$CAND2" ]; then
    shift
    exec "$CAND2" "$@"
else
    echo "file does not exist or is not executable: '$CAND1' or '$CAND2'"
    exit 1
fi
